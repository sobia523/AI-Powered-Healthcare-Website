# MongoDB Connection URI (Leave empty to use local file-based database api/mock_db.json)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthcare

# JWT Secret Key for token-based authentication (Change this to a strong random string in production)
JWT_SECRET=careconnect_jwt_secret_key_change_me_in_production

# Express Backend Server Port
PORT=5000

# Node Environment (development / production)
NODE_ENV=development
